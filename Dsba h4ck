-- Auto Remove Combat Log / Combat Tag
MainTab:CreateToggle({
   Name = "Auto Remove Combat Tag",
   CurrentValue = false,
   Callback = function(Value)
      AutoRemoveCombat = Value
      task.spawn(function()
          while AutoRemoveCombat do
              task.wait(0.5)
              -- Detects and destroys common combat tags in character or player
              for _, v in pairs(LocalPlayer.Character:GetChildren()) do
                  if string.find(string.lower(v.Name), "combat") or string.find(string.lower(v.Name), "tag") then
                      v:Destroy()
                  end
              end
          end
      end)
   end,
})

